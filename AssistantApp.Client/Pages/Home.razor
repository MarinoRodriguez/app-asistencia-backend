@page "/"
@using AssistantApp.Shared.Models
@using AssistantApp.Client.Services
@inject ClientEventService EventService

<PageTitle>AsistenciaApp</PageTitle>

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">Bienvenido</h1>
        <p class="lead">Sistema de Gestión de Asistencia</p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Eventos Activos</h3>
                </div>
                <div class="card-body">
                    @if (loading)
                    {
                        <p>Cargando eventos...</p>
                    }
                    else if (activeEvents == null || !activeEvents.Any())
                    {
                        <p class="text-muted">No hay eventos en curso en este momento.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var evt in activeEvents)
                            {
                                <a href="/attendance/@evt.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">@evt.Title</h5>
                                        <small>Inició: @evt.ScheduledStartDate</small>
                                    </div>
                                    <span class="badge bg-success rounded-pill">TOMAR LISTA</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h3 class="card-title mb-0">Administración</h3>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/admin/events" class="btn btn-outline-dark">Gestionar Eventos</a>
                        <a href="/admin/people" class="btn btn-outline-dark">Gestionar Personas</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Event>? activeEvents;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Buscamos eventos en progreso
            var response = await EventService.GetAll(EventState.InProgress);
            if (response.Success)
            {
                activeEvents = response.Data;
            }
        }
        finally
        {
            loading = false;
        }
    }
}