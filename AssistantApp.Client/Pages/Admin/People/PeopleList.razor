@page "/admin/people"
@using AssistantApp.Shared.Models
@using AssistantApp.Client.Services
@inject ClientPersonService PersonService
@inject NavigationManager Navigation

<PageTitle>Gestión de Personas</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Personas</h2>
        <a href="/admin/people/create" class="btn btn-primary">+ Nueva Persona</a>
    </div>

    <!-- Buscador -->
    <div class="input-group mb-3">
        <input type="text" class="form-control" placeholder="Buscar por nombre o email..." 
               @bind="searchTerm" @bind:event="oninput" @onkeyup="Search" />
        <button class="btn btn-outline-secondary" @onclick="LoadData">Recargar</button>
    </div>

    @if (loading)
    {
        <p>Cargando...</p>
    }
    else if (people == null || !people.Any())
    {
        <div class="alert alert-info">No se encontraron personas.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Grupos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in people)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(p.PhotoUrl))
                                {
                                    <img src="@p.PhotoUrl" alt="Foto" class="rounded-circle" width="40" height="40" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white" style="width:40px; height:40px">
                                        @p.Name.FirstOrDefault()
                                    </div>
                                }
                            </td>
                            <td>@p.Name @p.LastName</td>
                            <td>@p.Email</td>
                            <td>
                                @foreach (var pg in p.PersonGroups)
                                {
                                    <span class="badge bg-info text-dark me-1">@pg.Group?.Name</span>
                                }
                            </td>
                            <td>
                                <a href="/admin/people/edit/@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Person>? people;
    private bool loading = true;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        var response = await PersonService.GetAll();
        if (response.Success)
        {
            people = response.Data;
        }
        loading = false;
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await LoadData();
            return;
        }

        // Optimización: Podríamos hacer debounce aquí, pero por ahora directo
        var response = await PersonService.Search(searchTerm);
        if (response.Success)
        {
            people = response.Data;
        }
    }
}