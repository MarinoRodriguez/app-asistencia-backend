@page "/admin/people/create"
@page "/admin/people/edit/{Id:int}"
@using AssistantApp.Shared.Models
@using AssistantApp.Client.Services
@inject ClientPersonService PersonService
@inject ClientGroupService GroupService
@inject NavigationManager Navigation

<PageTitle>@(Id == 0 ? "Nueva Persona" : "Editar Persona")</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-white">
            <h3 class="mb-0">@(Id == 0 ? "Nueva Persona" : "Editar Persona")</h3>
        </div>
        <div class="card-body">
            @if (loading)
            {
                <p>Cargando...</p>
            }
            else
            {
                <EditForm Model="person" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="person.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Apellido</label>
                        <InputText class="form-control" @bind-Value="person.LastName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="person.Email" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">URL Foto (Opcional)</label>
                        <InputText class="form-control" @bind-Value="person.PhotoUrl" />
                    </div>

                    <!-- Selector de Grupos -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Grupos</label>
                        <div class="card p-2" style="max-height: 200px; overflow-y: auto;">
                            @if (availableGroups != null)
                            {
                                @foreach (var group in availableGroups)
                                {
                                    var isChecked = selectedGroupIds.Contains(group.Id);
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" 
                                               checked="@isChecked" 
                                               @onchange="@(e => ToggleGroup(group.Id, e.Value))" 
                                               id="group_@group.Id">
                                        <label class="form-check-label" for="group_@group.Id">
                                            @group.Name
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Cargando grupos...</p>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/admin/people" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Person person = new();
    private List<Group>? availableGroups;
    private HashSet<int> selectedGroupIds = new();
    private bool loading = false;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        
        // 1. Cargar Grupos Disponibles
        var groupsResp = await GroupService.GetAll();
        if (groupsResp.Success)
        {
            availableGroups = groupsResp.Data;
        }

        // 2. Cargar Persona (si es edición)
        if (Id != 0)
        {
            var response = await PersonService.GetById(Id);
            if (response.Success && response.Data != null)
            {
                person = response.Data;
                // Mapear grupos actuales a la selección
                selectedGroupIds = person.PersonGroups.Select(pg => pg.GroupId).ToHashSet();
            }
            else
            {
                Navigation.NavigateTo("/admin/people");
            }
        }
        
        loading = false;
    }

    private void ToggleGroup(int groupId, object? checkedValue)
    {
        if (checkedValue is bool isChecked)
        {
            if (isChecked)
            {
                selectedGroupIds.Add(groupId);
            }
            else
            {
                selectedGroupIds.Remove(groupId);
            }
        }
    }

    private async Task Save()
    {
        // Reconstruir la relación PersonGroups antes de enviar
        person.PersonGroups = selectedGroupIds.Select(gid => new PersonGroup { GroupId = gid }).ToList();

        ApiResponse<Person> response;
        
        if (Id == 0)
        {
            response = await PersonService.Create(person);
        }
        else
        {
            response = await PersonService.Update(Id, person); 
        }

        if (response.Success)
        {
            Navigation.NavigateTo("/admin/people");
        }
        else
        {
            Console.WriteLine(response.Message);
        }
    }
}