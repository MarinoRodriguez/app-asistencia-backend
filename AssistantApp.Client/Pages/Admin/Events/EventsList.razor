@page "/admin/events"
@using AssistantApp.Shared.Models
@using AssistantApp.Client.Services
@inject ClientEventService EventService
@inject NavigationManager Navigation

<PageTitle>Gestión de Eventos</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Eventos</h2>
        <a href="/admin/events/create" class="btn btn-primary">+ Nuevo Evento</a>
    </div>

    @if (loading)
    {
        <p>Cargando...</p>
    }
    else if (events == null || !events.Any())
    {
        <div class="alert alert-info">No hay eventos registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Estado</th>
                        <th>Título</th>
                        <th>Fecha Inicio</th>
                        <th>Configuración</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in events)
                    {
                        <tr>
                            <td>
                                @switch (evt.State)
                                {
                                    case EventState.Draft:
                                        <span class="badge bg-secondary">Borrador</span>
                                        break;
                                    case EventState.Scheduled:
                                        <span class="badge bg-info text-dark">Programado</span>
                                        break;
                                    case EventState.InProgress:
                                        <span class="badge bg-success">En Curso</span>
                                        break;
                                    case EventState.Finished:
                                        <span class="badge bg-dark">Finalizado</span>
                                        break;
                                }
                            </td>
                            <td>@evt.Title</td>
                            <td>@evt.ScheduledStartDate?.ToString("g")</td>
                            <td>
                                @if (evt.AllowUninvited) { <span class="badge bg-light text-dark border me-1">No Invitados OK</span> }
                                @if (evt.AllowExternal) { <span class="badge bg-light text-dark border me-1">Externos OK</span> }
                            </td>
                            <td>
                                <a href="/admin/events/edit/@evt.Id" class="btn btn-sm btn-outline-primary">Editar / Invitar</a>
                                @if (evt.State == EventState.InProgress)
                                {
                                    <a href="/attendance/@evt.Id" class="btn btn-sm btn-success ms-1">Tomar Lista</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Event>? events;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        var response = await EventService.GetAll();
        if (response.Success)
        {
            events = response.Data;
        }
        loading = false;
    }
}