@page "/admin/events/create"
@page "/admin/events/edit/{Id:int}"
@using AssistantApp.Shared.Models
@using AssistantApp.Client.Services
@inject ClientEventService EventService
@inject ClientPersonService PersonService
@inject ClientGroupService GroupService
@inject NavigationManager Navigation

<PageTitle>@(Id == 0 ? "Nuevo Evento" : "Editar Evento")</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@(Id == 0 ? "Nuevo Evento" : "Editar Evento")</h2>
        @if (Id != 0)
        {
            <div>
                @if (evt.State == EventState.Scheduled || evt.State == EventState.Draft)
                {
                    <button class="btn btn-success me-2" @onclick="StartEvent">Iniciar Evento</button>
                }
                @if (evt.State == EventState.InProgress)
                {
                    <button class="btn btn-dark me-2" @onclick="FinishEvent">Finalizar Evento</button>
                    <a href="/attendance/@evt.Id" class="btn btn-outline-success">Ir a Tomar Lista</a>
                }
            </div>
        }
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "details" ? "active" : "")" @onclick='() => activeTab = "details"'>Detalles</button>
        </li>
        @if (Id != 0)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == "invitations" ? "active" : "")" @onclick='() => activeTab = "invitations"'>Invitaciones (@(evt.Invitations?.Count ?? 0))</button>
            </li>
        }
    </ul>

    <!-- Tab Content: Detalles -->
    @if (activeTab == "details")
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <EditForm Model="evt" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Título</label>
                            <InputText class="form-control" @bind-Value="evt.Title" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fecha y Hora Inicio</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="evt.ScheduledStartDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <InputTextArea class="form-control" @bind-Value="evt.Description" />
                    </div>

                    <h5 class="mt-4">Configuración</h5>
                    <div class="form-check form-switch mb-2">
                        <InputCheckbox class="form-check-input" @bind-Value="evt.AllowUninvited" id="allowUninvited" />
                        <label class="form-check-label" for="allowUninvited">Permitir marcar asistencia a NO invitados (Búsqueda)</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <InputCheckbox class="form-check-input" @bind-Value="evt.AllowExternal" id="allowExternal" />
                        <label class="form-check-label" for="allowExternal">Permitir registrar personas EXTERNAS (Nuevos)</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <InputCheckbox class="form-check-input" @bind-Value="evt.AutoStart" id="autoStart" />
                        <label class="form-check-label" for="autoStart">Auto-Inicio programado (Worker)</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/admin/events" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Tab Content: Invitaciones -->
    @if (activeTab == "invitations")
    {
        <div class="row">
            <!-- Columna Izquierda: Agregar Invitados -->
            <div class="col-md-5">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Agregar Invitados</h5>
                    </div>
                    <div class="card-body">
                        <!-- Selector de Modo -->
                        <div class="btn-group w-100 mb-3">
                            <button class="btn btn-outline-primary @(inviteMode == "person" ? "active" : "")" @onclick='() => inviteMode = "person"'>Personas</button>
                            <button class="btn btn-outline-primary @(inviteMode == "group" ? "active" : "")" @onclick='() => inviteMode = "group"'>Grupos</button>
                        </div>

                        @if (inviteMode == "person")
                        {
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" placeholder="Buscar persona..." 
                                       @bind="personSearchTerm" 
                                       @bind:event="oninput"
                                       @onkeyup="SearchPerson" />
                                @if (!string.IsNullOrEmpty(personSearchTerm))
                                {
                                    <button class="btn btn-outline-secondary" @onclick="ClearSearch">X</button>
                                }
                            </div>
                            
                            @if (personSearchResults.Any())
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted">Resultados: @personSearchResults.Count</small>
                                    @if (personSearchResults.Count > 1)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="InviteAllResults">Invitar Todos</button>
                                    }
                                </div>

                                <div class="list-group" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var p in personSearchResults)
                                    {
                                        var isInvited = evt.Invitations?.Any(i => i.PersonId == p.Id) ?? false;
                                        
                                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isInvited ? "disabled bg-light" : "")" 
                                                @onclick="() => InvitePerson(p.Id)">
                                            <span>@p.Name @p.LastName</span>
                                            @if (isInvited)
                                            {
                                                <span class="badge bg-secondary">Ya invitado</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">+</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                            else if (string.IsNullOrEmpty(personSearchTerm))
                            {
                                <p class="text-muted text-center mt-3">Escribe para buscar personas...</p>
                            }
                            else
                            {
                                <p class="text-muted text-center mt-3">No se encontraron personas.</p>
                            }
                        }
                        else
                        {
                            <p class="text-muted small">Invitar a un grupo agregará a todos sus miembros actuales.</p>
                            @if (availableGroups != null)
                            {
                                <div class="list-group">
                                    @foreach (var g in availableGroups)
                                    {
                                        var isExpanded = expandedGroups.Contains(g.Id);
                                        var memberCount = g.PersonGroups.Count;

                                        <div class="list-group-item p-0">
                                            <div class="d-flex justify-content-between align-items-center p-2">
                                                <div class="d-flex align-items-center" style="cursor: pointer;" @onclick="() => ToggleGroup(g.Id)">
                                                    <span class="me-2">@(isExpanded ? "▼" : "▶")</span>
                                                    <strong>@g.Name</strong>
                                                    <span class="badge bg-secondary ms-2">@memberCount</span>
                                                </div>
                                                <button class="btn btn-sm btn-primary" @onclick="() => InviteGroup(g.Id)">
                                                    Invitar Todos
                                                </button>
                                            </div>
                                            
                                            @if (isExpanded)
                                            {
                                                <div class="bg-light p-2 border-top">
                                                    @if (memberCount > 0)
                                                    {
                                                        <ul class="list-unstyled mb-0 ms-3">
                                                            @foreach (var pg in g.PersonGroups)
                                                            {
                                                                <li><small>• @pg.Person?.Name @pg.Person?.LastName</small></li>
                                                            }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-muted ms-3">Sin miembros.</small>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p>Cargando grupos...</p>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Lista Actual -->
            <div class="col-md-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Invitados Actuales</h5>
                        <span class="badge bg-secondary">Total: @(evt.Invitations?.Count ?? 0)</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush" style="max-height: 500px; overflow-y: auto;">
                            @if (evt.Invitations != null && evt.Invitations.Any())
                            {
                                @foreach (var inv in evt.Invitations)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@inv.Person?.Name @inv.Person?.LastName</strong>
                                            <small class="text-muted d-block">@inv.Person?.Email</small>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveInvitation(inv.PersonId)" title="Quitar invitación">
                                            <span class="oi oi-trash">X</span>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-center text-muted">No hay invitados aún.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Event evt = new() { ScheduledStartDate = DateTime.Now };
    private string activeTab = "details";
    
    // Invitaciones
    private string inviteMode = "person"; 
    
    // Búsqueda Personas
    private string personSearchTerm = "";
    private List<Person> personSearchResults = new();

    // Grupos
    private List<Group>? availableGroups;
    private HashSet<int> expandedGroups = new(); // Control de desplegables

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            await LoadEvent();
        }
        await SearchPerson();
    }

    private async Task LoadEvent()
    {
        var response = await EventService.GetById(Id);
        if (response.Success && response.Data != null)
        {
            evt = response.Data;
        }
    }

    private async Task Save()
    {
        ApiResponse<Event> response;
        if (Id == 0)
        {
            response = await EventService.Create(evt);
            if (response.Success && response.Data != null)
            {
                Navigation.NavigateTo($"/admin/events/edit/{response.Data.Id}");
            }
        }
        else
        {
            response = await EventService.Update(Id, evt);
            if (response.Success) await LoadEvent();
        }
    }

    private async Task StartEvent()
    {
        if (await EventService.StartEvent(Id) is var r && r.Success) await LoadEvent();
    }

    private async Task FinishEvent()
    {
        if (await EventService.FinishEvent(Id) is var r && r.Success) await LoadEvent();
    }

    // --- Lógica de Invitaciones ---

    private async Task SearchPerson()
    {
        ApiResponse<List<Person>> res;
        if (string.IsNullOrWhiteSpace(personSearchTerm))
        {
            res = await PersonService.GetAll();
        }
        else
        {
            res = await PersonService.Search(personSearchTerm);
        }

        if (res.Success) 
        {
            personSearchResults = res.Data ?? new();
        }
    }
    
    private void ClearSearch()
    {
        personSearchTerm = "";
        SearchPerson(); 
    }

    private async Task InvitePerson(int personId)
    {
        if (evt.Invitations?.Any(i => i.PersonId == personId) ?? false) return;

        var res = await EventService.InvitePerson(Id, personId);
        if (res.Success)
        {
            await LoadEvent(); 
        }
    }

    private async Task InviteAllResults()
    {
        foreach (var p in personSearchResults)
        {
            if (!(evt.Invitations?.Any(i => i.PersonId == p.Id) ?? false))
            {
                await EventService.InvitePerson(Id, p.Id);
            }
        }
        await LoadEvent();
    }

    private async Task RemoveInvitation(int personId)
    {
        var res = await EventService.RemoveInvitation(Id, personId);
        if (res.Success)
        {
            await LoadEvent();
        }
    }

    private async Task InviteGroup(int groupId)
    {
        var res = await EventService.InviteGroup(Id, groupId);
        if (res.Success)
        {
            await LoadEvent(); 
        }
    }

    private void ToggleGroup(int groupId)
    {
        if (expandedGroups.Contains(groupId))
            expandedGroups.Remove(groupId);
        else
            expandedGroups.Add(groupId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (availableGroups == null)
        {
            var res = await GroupService.GetAll();
            if (res.Success) availableGroups = res.Data;
        }
    }
}