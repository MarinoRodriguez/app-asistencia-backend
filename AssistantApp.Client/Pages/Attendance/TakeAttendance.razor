@page "/attendance/{EventId:int}"
@using AssistantApp.Shared.Models
@using AssistantApp.Client.Services
@inject ClientEventService EventService
@inject ClientAttendanceService AttendanceService
@inject ClientPersonService PersonService
@inject NavigationManager Navigation

<PageTitle>Tomar Asistencia</PageTitle>

@if (loading)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (currentEvent == null)
{
    <div class="alert alert-danger">Evento no encontrado.</div>
}
else
{
    <div class="container mt-3">
        <!-- Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">@currentEvent.Title</h2>
            <button class="btn btn-sm btn-outline-secondary" @onclick="GoBack">Volver</button>
        </div>

        <!-- Barra de Herramientas: Buscador -->
        <div class="input-group mb-4">
            <input type="text" class="form-control form-control-lg" 
                   placeholder="Buscar persona..." 
                   @bind="searchTerm" 
                   @bind:event="oninput"
                   @onkeyup="SearchPeople" />
            
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearSearch">X</button>
            }
        </div>

        <!-- Resultados de Búsqueda -->
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <h5 class="text-muted mb-2">Resultados de búsqueda</h5>
            <div class="list-group mb-4">
                @if (searchResults.Any())
                {
                    @foreach (var person in searchResults)
                    {
                        var isPresent = attendanceMap.ContainsKey(person.Id);
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@person.Name @person.LastName</strong>
                                <br/>
                                <small class="text-muted">@person.Email</small>
                            </div>
                            @if (isPresent)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveAttendance(person.Id)">
                                    DESHACER
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="() => MarkAttendance(person.Id)">
                                    MARCAR
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <!-- ZONA DE "NO ENCONTRADO" -->
                    <div class="list-group-item text-center py-4">
                        <p class="text-muted mb-3">No se encontraron personas con el nombre "<strong>@searchTerm</strong>".</p>
                        
                        @if (currentEvent.AllowExternal)
                        {
                            <div class="card bg-light border-0 p-3 d-inline-block">
                                <p class="mb-2 fw-bold">¿Deseas agregar a esta persona?</p>
                                <button class="btn btn-success" @onclick="ShowExternalFormWithSearch">
                                    <span class="oi oi-plus"></span> Agregar a "@searchTerm"
                                </button>
                            </div>
                        }
                        else
                        {
                            <small class="text-danger">Este evento no permite registrar externos.</small>
                        }
                    </div>
                }
            </div>
        }

        <!-- Lista Principal (Invitados + Asistentes No Invitados) -->
        @if (string.IsNullOrEmpty(searchTerm))
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="text-muted mb-0">Asistentes (@presentCount / @displayedPeople.Count)</h5>
            </div>

            <div class="list-group">
                @foreach (var person in displayedPeople)
                {
                    var isPresent = attendanceMap.ContainsKey(person.Id);
                    var isUninvited = !invitedIds.Contains(person.Id);
                    
                    var statusClass = isPresent ? "list-group-item-success" : "";
                    if (isUninvited) statusClass += " border-warning"; 

                    <div class="list-group-item @statusClass d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@person.Name @person.LastName</strong>
                            @if (isUninvited)
                            {
                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7em">EXTRA</span>
                            }
                            @if (isPresent)
                            {
                                <span class="badge bg-success ms-2">PRESENTE</span>
                            }
                        </div>
                        
                        @if (!isPresent)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkAttendance(person.Id)">
                                Marcar
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAttendance(person.Id)">
                                Deshacer
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<!-- Modal para Externos -->
@if (showExternalForm)
{
    <div class="modal d-block" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar Nuevo Asistente</h5>
                    <button type="button" class="btn-close" @onclick="CloseExternalForm"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Nombre</label>
                        <input class="form-control" @bind="newExternal.Name" placeholder="Ej: Juan" />
                    </div>
                    <div class="mb-3">
                        <label>Apellido</label>
                        <input class="form-control" @bind="newExternal.LastName" placeholder="Ej: Pérez" />
                    </div>
                    <div class="mb-3">
                        <label>Email (Opcional)</label>
                        <input class="form-control" @bind="newExternal.Email" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseExternalForm">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveExternal">Guardar y Marcar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int EventId { get; set; }

    private Event? currentEvent;
    
    private List<Person> displayedPeople = new(); 
    private HashSet<int> invitedIds = new();      
    private Dictionary<int, Assistance> attendanceMap = new();
    
    private string searchTerm = "";
    private List<Person> searchResults = new();
    
    private bool loading = true;
    private bool showExternalForm = false;
    private Person newExternal = new();

    private int presentCount => attendanceMap.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        
        var eventResp = await EventService.GetById(EventId);
        if (eventResp.Success)
        {
            currentEvent = eventResp.Data;
        }

        var attResp = await AttendanceService.GetByEvent(EventId);
        
        if (currentEvent != null)
        {
            var invitations = currentEvent.Invitations ?? new List<Invitation>();
            invitedIds = invitations.Select(i => i.PersonId).ToHashSet();
            
            var allPeopleMap = invitations
                .Where(i => i.Person != null)
                .ToDictionary(i => i.PersonId, i => i.Person!);

            if (attResp.Success && attResp.Data != null)
            {
                attendanceMap = attResp.Data.ToDictionary(a => a.PersonId, a => a);

                foreach (var assistance in attResp.Data)
                {
                    if (!allPeopleMap.ContainsKey(assistance.PersonId) && assistance.Person != null)
                    {
                        allPeopleMap.Add(assistance.PersonId, assistance.Person);
                    }
                }
            }

            displayedPeople = allPeopleMap.Values
                .OrderBy(p => p.LastName)
                .ThenBy(p => p.Name)
                .ToList();
        }

        loading = false;
    }

    private async Task SearchPeople()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            searchResults.Clear();
            return;
        }

        var resp = await PersonService.Search(searchTerm);
        if (resp.Success && resp.Data != null)
        {
            searchResults = resp.Data;
        }
    }

    private void ClearSearch()
    {
        searchTerm = "";
        searchResults.Clear();
    }

    private async Task MarkAttendance(int personId)
    {
        var resp = await AttendanceService.Mark(EventId, personId, AssistanceType.Present);
        if (resp.Success)
        {
            await LoadData();
            ClearSearch();
        }
    }

    private async Task RemoveAttendance(int personId)
    {
        var resp = await AttendanceService.Remove(EventId, personId);
        if (resp.Success)
        {
            await LoadData();
        }
    }

    // Método modificado para pre-llenar el nombre
    private void ShowExternalFormWithSearch()
    {
        newExternal = new Person();
        
        // Intentamos ser inteligentes: Si escribió "Juan Perez", separamos
        var parts = searchTerm.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 0) newExternal.Name = parts[0];
        if (parts.Length > 1) newExternal.LastName = string.Join(" ", parts.Skip(1));

        showExternalForm = true;
    }

    private void CloseExternalForm()
    {
        showExternalForm = false;
    }

    private async Task SaveExternal()
    {
        if (string.IsNullOrWhiteSpace(newExternal.Name)) return;

        var resp = await AttendanceService.RegisterExternal(EventId, newExternal);
        if (resp.Success)
        {
            await LoadData();
            CloseExternalForm();
            ClearSearch();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}