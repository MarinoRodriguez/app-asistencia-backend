<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AsistenciaApp</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <!-- Dashboard / Staff -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-3">
            <span class="text-light small text-uppercase fw-bold ps-3">Administración</span>
        </div>

        <!-- Admin: Eventos -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/events">
                <span class="bi bi-calendar-event" aria-hidden="true"></span> Eventos
            </NavLink>
        </div>

        <!-- Admin: Personas -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/people">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Personas
            </NavLink>
        </div>

        <!-- Admin: Grupos -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/groups">
                <span class="bi bi-collection-fill" aria-hidden="true"></span> Grupos
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}